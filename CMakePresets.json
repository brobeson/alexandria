{
  "version": 10,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "build/${presetName}",
      "installDir": "build/${presetName}/install",
      "cacheVariables": {
        "BUILD_TESTING": true
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug Configuration",
      "description": "Debug build with no developer instrumentation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release Configuration",
      "description": "Release build with no developer instrumentation.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "description": "Build the debug configuration.",
      "displayName": "Debug Build",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "description": "Build the release configuration.",
      "displayName": "Release Build",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "debug",
      "description": "Test the debug build.",
      "displayName": "Debug Test",
      "configurePreset": "debug",
      "configuration": "Debug",
      "inherits": ["base"]
    },
    {
      "name": "release",
      "description": "Test the release build.",
      "displayName": "Release Test",
      "configurePreset": "release",
      "configuration": "Release",
      "inherits": ["base"]
    }
  ],
  "workflowPresets": [
    {
      "name": "debug",
      "description": "Run a full debug workflow",
      "displayName": "Debug Workflow",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "description": "Run a full release workflow",
      "displayName": "Release Workflow",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    }
  ]
}
